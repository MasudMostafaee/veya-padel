---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ConceptDialog from '../components/ConceptDialog.astro';
import Hero from '../components/Hero.astro';
import WaysToPlay from '../components/WaysToPlay.astro';
import FirstTime from '../components/FirstTime.astro';
import Coaching from '../components/Coaching.astro';
import Pricing from '../components/Pricing.astro';
import Club from '../components/Club.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import CoachingDialog from '../components/CoachingDialog.astro';
import site from '../content/site.json';
---
<Base title={site.title} description={site.description}>
  <Header />
  <main>
    <Hero />
    <WaysToPlay />
    <FirstTime />
    <Coaching />
    <Pricing />
    <Club />
    <Faq />
    <Contact />
    <FinalCta />
  </main>
  <Footer />
  <ConceptDialog />
  <CoachingDialog />
</Base>

<script>
  import { initHeader } from '../scripts/header.js';
  import { initUi } from '../scripts/ui.js';
  import { initMotion } from '../scripts/motion.js';

  initUi();
  initHeader();
  initMotion();
</script>
