---
import '@fontsource/anton/400.css';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import '@fontsource-variable/hanken-grotesk/index.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d0b" />
    <link rel="preload" as="font" type="font/woff2" href={antonUrl} crossorigin />
    <link rel="preload" as="image" href={`${base}images/player.webp`} fetchpriority="high" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
