---
import why from '../content/why.json';
---
<section class="band on-paper why" id="club" tabindex="-1">
  <h2 data-reveal>{why.title}</h2>
  <p class="sub" data-reveal>{why.sub}</p>
  <ol class="grid" data-reveal-group>
    {why.items.map((item, i) => (
      <li>
        <span class="label">{String(i + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 56px; border-top: 1px solid var(--line); }
  li { padding: 22px 22px 44px; border-right: 1px solid var(--line); }
  li:first-child { padding-left: 0; }
  li:last-child { border-right: 0; }
  .label { display: block; margin-bottom: 64px; }
  li p { margin-top: 10px; font-size: 16px; line-height: 1.45; color: var(--sub); }
  @media (max-width: 960px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    li:nth-child(2n) { border-right: 0; }
    li:nth-child(n) { padding: 20px 20px 32px 0; }
    li:nth-child(2n) { padding-left: 20px; }
    li:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .label { margin-bottom: 32px; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    li:nth-child(n) { padding: 20px 0 28px; border-right: 0; border-bottom: 1px solid var(--line); }
    li:last-child { border-bottom: 0; }
    .label { margin-bottom: 20px; }
  }
</style>
