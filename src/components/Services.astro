---
import services from '../content/services.json';
const base = import.meta.env.BASE_URL;
---
<section class="band services" id="play" tabindex="-1">
  <h2 data-reveal>{services.title}</h2>
  <ul class="rows">
    {services.items.map((item) => (
      <li class="row" data-service-row data-reveal>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        <a class="btn" href="#final">{item.cta}</a>
        <img src={`${base}images/${item.image}`} alt={item.alt} width="900" height="1350" loading="lazy" decoding="async" data-service-img />
      </li>
    ))}
  </ul>
</section>

<style>
  .rows { margin-top: 56px; border-top: 1px solid var(--line); }
  .row {
    position: relative; display: grid; grid-template-columns: 1.3fr 1fr auto; align-items: center; gap: 32px;
    padding: 26px 0; border-bottom: 1px solid var(--line);
  }
  h3 { font-size: clamp(40px, 5.2vw, 84px); line-height: 1; transition: color 0.25s; }
  .row:hover h3 { color: var(--ball); }
  p { max-width: 38ch; color: var(--sub); font-size: 16px; line-height: 1.45; }
  img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; grid-column: 1 / -1; }

  @media (hover: hover) and (min-width: 761px) {
    img {
      position: absolute; left: 0; top: 0; z-index: 4; width: 240px; height: 300px; margin: -150px 0 0 0;
      opacity: 0; pointer-events: none; transition: opacity 0.25s;
      translate: 58vw 50%;
    }
    .row:hover img, .row:focus-within img { opacity: 1; }
  }
  @media (hover: none) and (min-width: 761px) {
    .row { grid-template-columns: 1fr 1fr; }
    .row .btn { justify-self: start; }
  }
  @media (max-width: 760px) {
    .rows { margin-top: 40px; }
    .row { grid-template-columns: 1fr; gap: 14px; padding: 24px 0 28px; }
    h3 { font-size: 44px; }
    img { order: 3; grid-column: auto; }
    .row .btn { order: 4; }
  }
</style>
