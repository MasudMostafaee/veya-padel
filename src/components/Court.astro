---
const { class: className } = Astro.props;
---
<div class:list={['court', className]} aria-hidden="true" data-court>
  <canvas data-heat></canvas>
  <svg class="wide" viewBox="0 0 2000 1000" preserveAspectRatio="xMidYMid meet">
    <rect class="d" pathLength="1" x="10" y="10" width="1980" height="980" />
    <line class="d net" pathLength="1" x1="1000" y1="10" x2="1000" y2="990" />
    <line class="d" pathLength="1" x1="305" y1="10" x2="305" y2="990" />
    <line class="d" pathLength="1" x1="1695" y1="10" x2="1695" y2="990" />
    <line class="d" pathLength="1" x1="305" y1="500" x2="1695" y2="500" />
  </svg>
  <svg class="tall" viewBox="0 0 1000 2000" preserveAspectRatio="xMidYMid slice">
    <rect class="d" pathLength="1" x="10" y="10" width="980" height="1980" />
    <line class="d net" pathLength="1" x1="10" y1="1000" x2="990" y2="1000" />
    <line class="d" pathLength="1" x1="10" y1="305" x2="990" y2="305" />
    <line class="d" pathLength="1" x1="10" y1="1695" x2="990" y2="1695" />
    <line class="d" pathLength="1" x1="500" y1="305" x2="500" y2="1695" />
  </svg>
  <i class="ball" data-ball></i>
</div>

<style>
  .court { position: absolute; inset: 0; transform-origin: 50% 60%; }
  canvas, svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tall { display: none; }
  .d { fill: none; stroke: var(--line-dark); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .net { stroke: rgba(243, 245, 238, 0.42); stroke-width: 2; }
  .ball {
    position: absolute; left: 0; top: 0; width: 14px; height: 14px; margin: -7px 0 0 -7px;
    border-radius: 50%; background: var(--ball); box-shadow: 0 0 24px 4px rgba(210, 241, 29, 0.55);
    visibility: hidden; pointer-events: none;
  }
  @media (max-width: 760px) {
    .wide { display: none; }
    .tall { display: block; }
  }
</style>
