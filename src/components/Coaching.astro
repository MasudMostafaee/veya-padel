---
import coaching from '../content/coaching.json';
const base = import.meta.env.BASE_URL;
---
<section class="band" id="coaching" tabindex="-1">
  <p class="label accent" data-reveal>{coaching.label}</p>
  <h2 data-reveal>{coaching.title}</h2>
  <p class="sub" data-reveal>{coaching.sub}</p>
  <p class="alert" data-reveal><b>{coaching.alertTitle}</b> {coaching.alertText}</p>

  <ul class="rows">
    {coaching.tracks.map((track) => (
      <li class="row" data-service-row data-reveal>
        <div>
          <p class="label">{track.label}</p>
          <h3>{track.title}</h3>
        </div>
        <div>
          <p class="text">{track.text}</p>
          <ul class="meta">{track.meta.map((item) => <li>{item}</li>)}</ul>
        </div>
        <a class="btn" href={track.href}>{track.cta}</a>
        <img src={`${base}images/${track.image}`} alt={track.alt} width="900" height="1350" loading="lazy" decoding="async" data-service-img />
      </li>
    ))}
  </ul>

  <div class="block" id="group-coaching" tabindex="-1">
    <h3 class="block-title" data-reveal>{coaching.levelsTitle}</h3>
    <p class="sub" data-reveal>{coaching.levelsSub}</p>
    <div class="levels" data-reveal-group>
      {coaching.levels.map((item) => (
        <article>
          <p class="label accent">{item.level}</p>
          <h4>{item.title}</h4>
          <p class="text">{item.text}</p>
          <dl>
            <div><dt>Schedule</dt><dd>{item.schedule}</dd></div>
            <div><dt>Price</dt><dd>{item.price}</dd></div>
          </dl>
          <button class="btn" type="button" data-request={item.program}>Select &amp; Request</button>
        </article>
      ))}
    </div>
  </div>

  <div class="block" id="coaches" tabindex="-1">
    <h3 class="block-title" data-reveal>{coaching.coachesTitle}</h3>
    <p class="sub" data-reveal>{coaching.coachesSub}</p>
    <div class="coaches" data-reveal-group>
      {coaching.coaches.map((coach) => (
        <article>
          <div class="portrait">
            <img src={`${base}images/${coach.image}`} alt={`Portrait of ${coach.name}`} width="900" height="1350" loading="lazy" decoding="async" />
          </div>
          <h4>{coach.name}</h4>
          <p class="label accent">{coach.role}</p>
          <p class="text">{coach.bio}</p>
          <p class="creds">{coach.creds}</p>
          <button class="btn" type="button" data-request={coach.program}>Request Coach</button>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { margin-top: 16px; }
  .accent { color: var(--ball); }
  .alert { max-width: 72ch; margin-top: 32px; padding: 16px 0; border-block: 1px solid var(--line); font-size: 16px; color: var(--soft); }
  .alert b { color: var(--ball); font-weight: 600; }
  .text { color: var(--sub); font-size: 16px; line-height: 1.45; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 10px; font: 400 12px var(--mono); color: var(--sub); }

  .rows { margin-top: 56px; border-top: 1px solid var(--line); }
  .row { position: relative; display: grid; grid-template-columns: 1.2fr 1fr auto; align-items: center; gap: 32px; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .row h3 { margin-top: 8px; font-size: clamp(40px, 5.2vw, 84px); line-height: 1; transition: color 0.25s; }
  .row:hover h3 { color: var(--ball); }
  .row > img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; grid-column: 1 / -1; }

  .block { margin-top: clamp(72px, 12vh, 120px); }
  .block-title { font-size: clamp(36px, 4.4vw, 64px); line-height: 1; }
  .levels, .coaches { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 40px; }
  .levels { border-top: 1px solid var(--line); }
  .levels article { display: flex; flex-direction: column; padding: 22px 24px 8px; border-right: 1px solid var(--line); }
  .levels article:first-child { padding-left: 0; }
  .levels article:last-child { border-right: 0; padding-right: 0; }
  h4 { margin: 12px 0 8px; font: 400 30px/1.05 var(--display); text-transform: uppercase; }
  dl { margin: 18px 0 22px; }
  dl div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--line); font-size: 15px; }
  dt { color: var(--sub); }
  dd { margin: 0; font-weight: 600; }
  article .btn { margin-top: auto; }
  .coaches { gap: 24px; }
  .coaches article { display: flex; flex-direction: column; align-items: flex-start; }
  .portrait { width: 100%; aspect-ratio: 4 / 5; overflow: hidden; margin-bottom: 8px; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  article:hover .portrait img { transform: scale(1.04); }
  .coaches .text { margin-top: 10px; }
  .creds { margin: 10px 0 18px; font: 400 12px var(--mono); color: var(--sub); }
  .coaches .btn { align-self: stretch; }

  @media (hover: hover) and (min-width: 761px) {
    .row > img { position: absolute; left: 0; top: 0; z-index: 4; width: 240px; height: 300px; margin: -150px 0 0 0; opacity: 0; pointer-events: none; transition: opacity 0.25s; translate: 58vw 50%; }
    .row:hover > img, .row:focus-within > img { opacity: 1; }
  }
  @media (hover: none) and (min-width: 761px) {
    .row { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 960px) {
    .levels { grid-template-columns: 1fr; border-top: 0; }
    .levels article:nth-child(n) { padding: 20px 0 24px; border-right: 0; border-top: 1px solid var(--line); }
    .coaches { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .rows { margin-top: 40px; }
    .row { grid-template-columns: 1fr; gap: 14px; padding: 24px 0 28px; }
    .row h3 { font-size: 44px; }
    .row > img { order: 3; grid-column: auto; }
    .row > .btn { order: 4; }
  }
  @media (max-width: 560px) {
    .coaches { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
