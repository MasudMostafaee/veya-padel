---
import Logo from './Logo.astro';
import site from '../content/site.json';
---
<header class="site" data-header>
  <a class="brand" href="#top" aria-label={`${site.name}, home`}><Logo class="logo" /></a>
  <nav aria-label="Main">
    {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="btn primary book" href="#final">{site.bookLabel}</a>
  <button class="btn menu-open" type="button" data-menu-open aria-haspopup="dialog">Menu</button>
</header>

<dialog class="menu" data-menu aria-label="Menu">
  <div class="menu-top">
    <a class="brand" href="#top" aria-label={`${site.name}, home`}><Logo class="logo" /></a>
    <form method="dialog"><button class="btn">Close</button></form>
  </div>
  <nav aria-label="Mobile">
    {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="btn primary" href="#final">{site.bookLabel}</a>
</dialog>

<style>
  .site {
    position: fixed; inset: 0 0 auto 0; z-index: 30;
    display: flex; align-items: center; gap: 32px;
    height: var(--header-h); padding: 0 var(--gutter);
    color: var(--paper);
    --line: var(--line-dark); --focus: var(--ball);
    transition: transform 0.4s var(--ease);
  }
  .site::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgba(11, 13, 11, 0.86);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    opacity: 0; transition: opacity 0.25s;
  }
  .site:hover::before, .site:focus-within::before, .site.is-solid::before { opacity: 1; }
  .site.is-hidden { transform: translateY(-100%); }
  .site.is-hidden:focus-within { transform: none; }
  .brand { display: block; }
  .brand :global(.logo) { height: 28px; width: auto; }
  .site nav { display: flex; gap: 28px; margin-left: 12px; font-size: 14px; font-weight: 500; }
  .site nav a { opacity: 0.72; transition: opacity 0.2s; }
  .site nav a:hover, .site nav a:focus-visible { opacity: 1; }
  .book { margin-left: auto; min-height: 44px; padding: 0 20px; font-size: 14px; }
  .menu-open { display: none; min-height: 44px; padding: 0 14px; font-size: 14px; }

  .menu {
    position: fixed; inset: 0; width: 100%; max-width: none; height: 100dvh; max-height: none;
    margin: 0; padding: 0 16px 24px; border: 0;
    background: var(--ink); color: var(--paper);
    --line: var(--line-dark); --focus: var(--ball);
  }
  .menu[open] { display: flex; flex-direction: column; }
  .menu-top { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .menu-top .btn { min-height: 44px; padding: 0 14px; font-size: 14px; }
  .menu nav { display: flex; flex-direction: column; margin-top: 24px; }
  .menu nav a { padding: 14px 0; border-bottom: 1px solid var(--line); font: 400 44px/1.1 var(--display); text-transform: uppercase; }
  .menu > .btn { margin-top: auto; }

  @media (max-width: 760px) {
    .site { gap: 10px; height: 68px; padding: 0 16px; }
    .site nav { display: none; }
    .brand :global(.logo) { height: 24px; }
    .book { padding: 0 14px; }
    .menu-open { display: inline-flex; }
  }
</style>
