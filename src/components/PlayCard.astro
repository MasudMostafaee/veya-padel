---
const { card } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<article class="play" data-reveal>
  <div class="frame" data-zoom>
    <img src={`${base}images/${card.image}`} alt={card.alt} width="900" height="1350" loading="lazy" decoding="async" style={card.focus && `object-position: ${card.focus}`} />
  </div>
  <p class="label">{card.label}</p>
  <h3>{card.title}</h3>
  <p class="text">{card.text}</p>
  <ul class="meta">{card.meta.map((item) => <li>{item}</li>)}</ul>
  <slot />
</article>

<style>
  .play { display: flex; flex-direction: column; align-items: flex-start; }
  .frame { width: 100%; aspect-ratio: 4 / 3; overflow: hidden; margin-bottom: 24px; }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  h3 { margin-top: 12px; font-size: clamp(40px, 4.6vw, 72px); line-height: 1; }
  .text { margin-top: 12px; color: var(--sub); }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 16px 0 24px; font: 400 12px var(--mono); color: var(--sub); }
  .play :global(.btn) { margin-top: auto; align-self: stretch; }
</style>
