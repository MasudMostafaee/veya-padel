---
const { card } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<article class="play" data-reveal>
  <div class="frame" data-zoom>
    <img src={`${base}images/${card.image}`} alt={card.alt} width="900" height="1350" loading="lazy" decoding="async" style={card.focus && `object-position: ${card.focus}`} />
  </div>
  <p class="label">{card.label}</p>
  <h3>{card.title}</h3>
  <p class="text">{card.text}</p>
  <ul class="meta">{card.meta.map((item) => <li>{item}</li>)}</ul>
  <slot />
</article>

<style>
  .play { display: flex; flex-direction: column; align-items: flex-start; }
  .frame { width: 100%; height: clamp(220px, 41vh, 440px); overflow: hidden; margin-bottom: 18px; }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  h3 { margin-top: 8px; font-size: clamp(36px, 3.6vw, 56px); line-height: 1; }
  .text { margin-top: 8px; color: var(--sub); font-size: 16px; line-height: 1.4; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 10px 0 16px; font: 400 12px var(--mono); color: var(--sub); }
  .play :global(.btn) { margin-top: auto; align-self: stretch; }
  @media (max-width: 760px) {
    .frame { height: auto; aspect-ratio: 4 / 3; }
  }
</style>
