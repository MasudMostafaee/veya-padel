---
import Logo from './Logo.astro';
import site from '../content/site.json';
import footer from '../content/footer.json';
---
<footer class="band footer">
  <Logo class="big" />
  <div class="legal">
    <p>{footer.copyright}</p>
    {footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
    <button type="button" data-concept={footer.clubNote}>{footer.club}</button>
    <p class="concept">{footer.concept}</p>
  </div>
  <p class="visually-hidden">{site.name}</p>
</footer>

<style>
  .footer { padding-top: 72px; padding-bottom: 28px; border-top: 1px solid var(--line); }
  .footer :global(.big) { width: 100%; height: auto; }
  .legal { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; margin-top: 28px; color: var(--mute); font-size: 13px; }
  .legal a, .legal button { display: flex; align-items: center; min-height: 44px; }
  .legal button { padding: 0; border: 0; background: none; cursor: pointer; font-size: 13px; }
  .legal a:hover, .legal button:hover { color: var(--ball); }
  .concept { margin-left: auto; font-family: var(--mono); font-size: 12px; }
  @media (max-width: 860px) {
    .concept { margin-left: 0; width: 100%; }
  }
</style>
