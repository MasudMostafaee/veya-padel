---
import faq from '../content/faq.json';
const base = import.meta.env.BASE_URL;
---
<section class="band on-paper faq" id="faq" tabindex="-1">
  <div class="main">
    <p class="label" data-reveal>{faq.label}</p>
    <h2 data-reveal>{faq.title}</h2>
    <div class="list">
      {faq.items.map((item) => (
        <details>
          <summary>{item.q}<span class="sign" aria-hidden="true"></span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
  <aside class="help" data-reveal>
    <div class="frame">
      <img src={`${base}images/${faq.image}`} alt={faq.alt} width="900" height="1350" loading="lazy" decoding="async" />
    </div>
    <h3>{faq.helpTitle}</h3>
    <p>{faq.helpText}</p>
    <button class="btn" type="button" data-concept={faq.helpNote}>{faq.helpCta}</button>
  </aside>
</section>

<style>
  .faq { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: start; }
  h2 { margin-top: 16px; }
  .list { margin-top: 40px; border-top: 1px solid var(--ink); }
  details { border-bottom: 1px solid var(--ink); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    min-height: 68px; padding: 16px 0; list-style: none; cursor: pointer;
    font: 400 26px/1.1 var(--display); text-transform: uppercase;
  }
  summary::-webkit-details-marker { display: none; }
  .sign { position: relative; flex: none; width: 18px; height: 18px; }
  .sign::before, .sign::after { content: ''; position: absolute; left: 0; top: 8px; width: 18px; height: 2px; background: currentColor; transition: transform 0.3s var(--ease); }
  .sign::after { transform: rotate(90deg); }
  details[open] .sign::after { transform: rotate(0); }
  details::details-content { block-size: 0; overflow: clip; transition: block-size 0.35s var(--ease), content-visibility 0.35s allow-discrete; }
  details[open]::details-content { block-size: auto; }
  details p { max-width: 58ch; padding-bottom: 22px; color: var(--sub); }
  .frame { overflow: hidden; aspect-ratio: 4 / 3; margin-bottom: 20px; }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .help p { margin: 8px 0 18px; color: var(--sub); font-size: 16px; }
  @media (max-width: 860px) {
    .faq { grid-template-columns: 1fr; gap: 40px; }
    summary { font-size: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    details::details-content, .sign::before, .sign::after { transition: none; }
  }
</style>
