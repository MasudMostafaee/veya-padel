---
import PlayCard from './PlayCard.astro';
import ways from '../content/ways.json';
import site from '../content/site.json';
---
<section class="band on-paper" id="ways" tabindex="-1">
  <p class="label" data-reveal>{ways.label}</p>
  <h2 data-reveal>{ways.title}</h2>
  <p class="sub" data-reveal>{ways.sub}</p>
  <div class="cards">
    {ways.cards.map((card) => (
      <PlayCard card={card}>
        <button class:list={['btn', { primary: card.primary }]} type="button" data-concept={site.bookNote}>{card.cta}</button>
      </PlayCard>
    ))}
  </div>
</section>

<style>
  h2 { margin-top: 16px; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 56px; }
  @media (max-width: 760px) {
    .cards { grid-template-columns: 1fr; gap: 40px; margin-top: 40px; }
  }
</style>
