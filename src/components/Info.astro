---
import info from '../content/info.json';
const base = import.meta.env.BASE_URL;
---
<section class="band on-paper info" id="info" tabindex="-1">
  <div class="text">
    <h2 data-reveal>{info.title}</h2>
    <dl data-reveal-group>
      {info.groups.map((group) => (
        <div>
          <dt class="label">{group.label}</dt>
          {group.lines.map((line) => <dd>{line}</dd>)}
        </div>
      ))}
    </dl>
    <button class="btn" type="button" data-concept={info.directionsNote}>{info.directions}</button>
  </div>
  <div class="frame" data-parallax>
    <img src={`${base}images/${info.image}`} alt={info.alt} width="1600" height="1200" loading="lazy" decoding="async" />
  </div>
</section>

<style>
  .info { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: stretch; }
  dl { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 24px; margin: 48px 0 40px; }
  dt { margin-bottom: 10px; color: var(--sub); }
  dd { font-size: 17px; font-weight: 500; line-height: 1.4; overflow-wrap: anywhere; }
  .frame { position: relative; overflow: hidden; min-height: 420px; }
  .frame img { position: absolute; left: 0; top: -8%; width: 100%; height: 116%; object-fit: cover; }
  @media (max-width: 860px) {
    .info { grid-template-columns: 1fr; gap: 40px; }
    .frame { min-height: 0; aspect-ratio: 4 / 3; }
  }
  @media (max-width: 420px) {
    dl { grid-template-columns: 1fr; }
  }
</style>
